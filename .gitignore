# Local environments and Python caches
/AGENTS.md
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
# Regenerable local work and staging (inspect locks/backups before cleanup)
.build-work/
.normalization-work/
.readiness-work/
data/.processed-*/
data/.processed-backup/
# Regenerable normalization outputs are retained locally, not uploaded.
/data/interim/
# Optional runtime dependencies and editor state
node_modules/
.vscode/
.idea/
.DS_Store
Thumbs.db
# Personal vault state is retained locally
docs/.obsidian/
/docs/archived/
# Excel's open-workbook locks are transient, not datasets.
~$*.xlsx
# Credentials must never enter version control
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
# Other scientific data and manifests are not blanket-ignored.
# Provider/source permissions are independent of ignore rules.
